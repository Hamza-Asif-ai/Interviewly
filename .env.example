# ============================================================
#  Interviewly - Environment Configuration
#  Copy this file to ".env" and fill in your real values.
# ============================================================

# --- LLM / Gemini (OpenAI-compatible endpoint) ---
# Paste your Google AI Studio (Gemini) API key here (starts with "AIza..." or "AQ...").
OPENAI_API_KEY=

# OpenAI-compatible Base URL for Gemini.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Primary model. The app automatically falls back through
# MODEL_FALLBACKS in app/services/llm.py if this 404s.
# NOTE: gemini-2.0-flash is used as primary; fallbacks cover 2.5/1.5 and
# finally gemini-flash-latest (verified working for new accounts).
LLM_MODEL=gemini-2.0-flash

# Maximum time (seconds) the LLM may take before the Prep Engine falls
# back to data/prep_guide_fallback.json.
LLM_TIMEOUT=60

# Prep Engine generation attempts before falling back to the JSON guide.
PREP_RETRIES=2
# Max output tokens requested from the LLM in one call.
PREP_MAX_TOKENS=8192

# --- Speech-to-text ---
WHISPER_MODEL=small
WHISPER_API_ENABLED=false

# --- Upload limits ---
MAX_UPLOAD_MB=200

# --- Server ---
# Render/Heroku inject PORT; default for local/docker is 7860.
HOST=0.0.0.0
PORT=7860