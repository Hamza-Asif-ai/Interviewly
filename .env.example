# ============================================================
#  Interviewly - Environment Configuration
#  Copy this file to ".env" and fill in your real values.
# ============================================================

# --- LLM / Gemini (OpenAI-compatible endpoint) ---
# Paste your Google AI Studio (Gemini) API key here (starts with "AIza..." or "AQ...").
# GEMINI_API_KEY is also accepted and is used when OPENAI_API_KEY is empty.
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible Base URL for Gemini.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Primary model; update on Render if Google retires it (verify on the official Models page).
LLM_MODEL=gemini-3.8-flash
# Ordered fallbacks, tried when the primary returns an error or empty content.
LLM_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Per-model timeout (hard cap 30s) and total budget (hard cap 60s) for one LLM call.
LLM_TIMEOUT=30
LLM_TOTAL_TIMEOUT=60

# Hard wall-clock cap for every backend processing step (audio extraction, Whisper,
# MediaPipe, analysis) in seconds.
PIPELINE_STEP_TIMEOUT=60

# Generation attempts before returning 503 (no silent guide substitution).
PREP_RETRIES=2
# Max output tokens requested from the LLM in one call.
PREP_MAX_TOKENS=8192

# --- Speech-to-text ---
WHISPER_MODEL=base
# Empty means auto-detect; set en/ur to force one language.
WHISPER_LANG=
WHISPER_API_ENABLED=false

# --- Upload limits ---
MAX_UPLOAD_MB=50
MAX_INPUT_CHARS=20000

# --- RAG ---
RAG_CONTEXT_CHARS=4000
RAG_MAX_CHUNKS=8

# --- Rate limits, concurrency and privacy ---
# Expensive /prep/generate, /practice/upload and Gradio call/run/queue POSTs are counted.
RATE_LIMIT_PER_MINUTE=20
# Shared by the FastAPI API and the Gradio handlers.
MAX_CONCURRENT_ANALYSES=2
# Comma-separated proxy IPs allowed to set X-Forwarded-For. Render's Cloudflare
# edge supplies CF-Connecting-IP, which is used instead when the peer is a proxy.
TRUSTED_PROXY_IPS=
# Comma-separated browser origins; empty means localhost only.
CORS_ORIGINS=
# SQLite records and orphaned uploads older than this are deleted.
RETENTION_HOURS=168
# How often the background retention task runs.
RETENTION_INTERVAL_HOURS=6
# Generated PDFs older than this are deleted.
PDF_TTL_HOURS=48
# Optional path to a DejaVu Unicode .ttf for PDF export.
PDF_FONT_PATH=

# --- Storage paths (optional overrides) ---
DATABASE_URL=
UPLOAD_DIR=
PDF_DIR=
CHROMA_DIR=

# --- Server ---
# Render/Heroku inject PORT; default for local/docker is 7860.
HOST=0.0.0.0
PORT=7860
